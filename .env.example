# ==============================================================================
# Agentic Lead Intelligence - Universal Environment Configuration Example
# ==============================================================================

# Application Environment (development / production)
APP_ENV=production

# ------------------------------------------------------------------------------
# Database Connection URL (PostgreSQL / Neon Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# Neon Cloud PostgreSQL (Production):
DATABASE_URL=postgresql://<user>:<password>@<endpoint-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# Local PostgreSQL (Development):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_intelligence

# ------------------------------------------------------------------------------
# Universal LLM Configuration
# ------------------------------------------------------------------------------
# Any provider is supported: openrouter, openai, gemini, groq, anthropic, deepseek, ollama, mistral, together, etc.
LLM_PROVIDER=openrouter
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-4o-mini

# Optional: Leave blank to auto-resolve to the standard endpoint for LLM_PROVIDER
LLM_BASE_URL=

# ------------------------------------------------------------------------------
# Public Search Provider (Tavily AI Web Search)
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Pipeline Governance & Limits
# ------------------------------------------------------------------------------
MAX_AGENT_ITERATIONS=5
MAX_LLM_CALLS_PER_ARTICLE=5
REQUEST_TIMEOUT_SECONDS=20