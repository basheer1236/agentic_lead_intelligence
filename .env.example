# Application Environment (development / production)
APP_ENV=production

# PostgreSQL Database Connection URL
# Replace with your PostgreSQL host, user, password, and database name
DATABASE_URL=postgresql://postgres:postgres:Password@localhost:5432/lead_intelligence

# LLM Provider Configuration
# Supported providers: openai, gemini, groq, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Public Search Provider (Tavily AI Web Search)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Pipeline Governance & Limits
MAX_AGENT_ITERATIONS=5
MAX_LLM_CALLS_PER_ARTICLE=5
REQUEST_TIMEOUT_SECONDS=20